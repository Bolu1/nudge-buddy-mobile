# Nest backend (same value as NEXT_PUBLIC_API_URL in the web app)
EXPO_PUBLIC_API_URL=https://api.example.com/v1
# Deployed Next.js web app — mobile uses its /api/tts and /api/stt-token routes
EXPO_PUBLIC_WEB_URL=https://app.example.com
# Google sign-in (optional). Web client id = the one the backend verifies against.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Native ids (optional overrides)
IOS_BUNDLE_ID=com.nudgebuddy.app
# Apple Developer Team ID (signs the Dynamic Island widget extension)
APPLE_TEAM_ID=
ANDROID_PACKAGE=com.nudgebuddy.app
# Path to google-services.json (Android push via FCM)
GOOGLE_SERVICES_JSON=./google-services.json
EAS_PROJECT_ID=
